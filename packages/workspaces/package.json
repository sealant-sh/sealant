{
  "name": "@sealant/workspaces",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace image lifecycle package: build, publish, deploy, and orchestration",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./cloudflare/bridge-contract": "./src/runtime/cloudflare/bridge-contract.ts",
    "./git/working-tree-changes": "./src/git/working-tree-changes.ts",
    "./testing/recorded-boat": "./src/runtime/boat/recorded-boat.fixture.ts"
  },
  "scripts": {
    "lint": "oxlint .",
    "test": "vitest run",
    "test:boat-harness": "vitest run --config vitest.boat-harness.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsrs -p tsconfig.json --noEmit --checkers 1"
  },
  "dependencies": {
    "@aws-sdk/client-lambda-microvms": "3.1131.0",
    "@aws-sdk/client-s3": "3.1131.0",
    "@kubernetes/client-node": "catalog:",
    "@sealant/api-contracts": "workspace:*",
    "@sealant/credentials": "workspace:*",
    "@sealant/db": "workspace:*",
    "@sealant/jobs": "workspace:*",
    "@sealant/runtime-client": "npm:@sealant/runtime-client-next@0.21.0-next.180",
    "@sealant/runtime-protocol": "npm:@sealant/runtime-protocol-next@0.21.0-next.180",
    "@sealant/source-integrations": "workspace:*",
    "@sealant/validators": "workspace:*",
    "effect": "catalog:",
    "undici": "catalog:",
    "ws": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@sealant/sdk": "workspace:*",
    "@sealant/typescript": "workspace:*",
    "@types/ws": "catalog:",
    "vitest": "catalog:"
  }
}
