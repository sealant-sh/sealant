{
  "name": "@sealant/workspaces",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace image lifecycle package: build, publish, deploy, and orchestration",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./cloudflare/bridge-contract": "./src/runtime/cloudflare/bridge-contract.ts"
  },
  "scripts": {
