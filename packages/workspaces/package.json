    "@sealant/db": "workspace:*",
    "@sealant/jobs": "workspace:*",
    "@sealant/runtime-client": "^0.13.0",
    "@sealant/runtime-protocol": "^0.13.0",
    "@sealant/source-integrations": "workspace:*",
    "@sealant/validators": "workspace:*",
    "effect": "catalog:",
    "ws": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@sealant/typescript": "workspace:*",
    "@types/ws": "catalog:"
