#!/bin/sh
# The `docker` sealant's worker and API find first on their PATH in the harness. It adds the run's
# label to every container, network and volume they create, so teardown, the reaper and cleanup
# remove only what this run owns. Everything else passes through unchanged. sealant passes its
# daemon through DOCKER_HOST, never as a global option; a global option is refused so nothing is
# created unlabelled.
set -eu
real="${SEALANT_BOAT_HARNESS_REAL_DOCKER:?boat-harness docker wrapper: SEALANT_BOAT_HARNESS_REAL_DOCKER unset}"
run="${SEALANT_BOAT_HARNESS_RUN:?boat-harness docker wrapper: SEALANT_BOAT_HARNESS_RUN unset}"
label="sh.sealant.boat-harness=$run"
case "${1:-}" in
  -*)
    echo "boat-harness docker wrapper: global options are not supported ($1)" >&2
    exit 97
    ;;
  run | create)
    command=$1
    shift
    exec "$real" "$command" --label "$label" "$@"
    ;;
  container)
    if [ "${2:-}" = run ] || [ "${2:-}" = create ]; then
      command=$2
      shift 2
      exec "$real" container "$command" --label "$label" "$@"
    fi
    ;;
  network | volume)
    if [ "${2:-}" = create ]; then
      kind=$1
      shift 2
      exec "$real" "$kind" create --label "$label" "$@"
    fi
    ;;
esac
# A fault some scenarios arm: while the file named by SEALANT_BOAT_HARNESS_CONFIGURE_DELAY_FILE
# exists, a `docker exec ... configure` (sealant configuring a resource gateway) first touches
# "<file>.started", then waits the seconds the file holds. Unset or absent, nothing changes.
delay="${SEALANT_BOAT_HARNESS_CONFIGURE_DELAY_FILE:-}"
if [ "${1:-}" = exec ] && [ -n "$delay" ] && [ -f "$delay" ]; then
  case " $* " in
    *" configure "*)
      : > "$delay.started"
      sleep "$(cat "$delay")"
      ;;
  esac
fi
exec "$real" "$@"
