[Unit]
Description=Sealant authenticated hosted bootstrap relay
After=local-fs.target sealant-bootstrap.service
Requires=sealant-bootstrap.service
ConditionPathExists=/run/sealant-bootstrap/relay.token

[Service]
Type=simple
NotifyAccess=none
KillMode=control-group
Restart=on-failure
RestartSec=1
UMask=0077
ExecStart=/var/lib/sealant/guest/bundle/lib64/ld-linux-x86-64.so.2 --inhibit-cache --library-path /var/lib/sealant/guest/bundle/lib/x86_64-linux-gnu:/var/lib/sealant/guest/bundle/usr/lib/x86_64-linux-gnu:/var/lib/sealant/guest/bundle/usr/lib/x86_64-linux-gnu/systemd /var/lib/sealant/guest/bundle/usr/bin/node /usr/local/lib/sealant/control-relay.cjs --socket /run/sealant-bootstrap/admission-unavailable.sock --token-file /run/sealant-bootstrap/relay.token --bootstrap-socket /run/sealant-bootstrap/receiver.sock --port 8080
