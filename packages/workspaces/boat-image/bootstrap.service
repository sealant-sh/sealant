[Unit]
Description=Sealant authenticated private admission receiver
After=local-fs.target
ConditionPathExists=/run/sealant-bootstrap/control.json

[Service]
Type=simple
NotifyAccess=none
KillMode=control-group
Restart=on-failure
RestartSec=1
UMask=0077
ExecStart=/var/lib/sealant/guest/bundle/lib64/ld-linux-x86-64.so.2 --inhibit-cache --library-path /var/lib/sealant/guest/bundle/lib/x86_64-linux-gnu:/var/lib/sealant/guest/bundle/usr/lib/x86_64-linux-gnu:/var/lib/sealant/guest/bundle/usr/lib/x86_64-linux-gnu/systemd /var/lib/sealant/guest/bundle/usr/bin/python3 -I -S -B /var/lib/sealant/guest/guest_receiver.py
