{
  "name": "@sealant/auth",
  "version": "0.0.0",
  "private": true,
  "description": "Shared Better Auth package for Sealant product apps",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./env": "./src/runtime-env.ts",
    "./server": "./src/server.ts",
    "./session": "./src/session.ts"
  },
  "scripts": {
    "lint": "OXLINT_TSGOLINT_PATH=../../node_modules/.bin/tsrs-lint oxlint --type-aware .",
    "typecheck": "tsrs -p tsconfig.json --noEmit --checkers 1"
  },
  "dependencies": {
    "@sealant/db": "workspace:*",
    "@sealant/validators": "workspace:*",
    "better-auth": "^1.4.13"
  },
  "devDependencies": {
    "@sealant/typescript": "workspace:*"
  }
}
