{
  "name": "@sealant/api-contracts",
  "version": "0.23.0",
  "description": "Contract-first HTTP API definitions for Sealant services",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sealant-sh/sealant.git",
    "directory": "packages/api-contracts"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./workspace-environment": "./src/workspace-environment.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./workspace-environment": {
        "types": "./dist/workspace-environment.d.ts",
        "import": "./dist/workspace-environment.js"
      }
    }
  },
  "scripts": {
    "build": "tsgo -p tsconfig.build.json",
    "lint": "oxlint .",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsgo -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@sealant/typescript": "workspace:*",
    "effect": "catalog:"
  },
  "peerDependencies": {
    "effect": ">=4.0.0-beta.85 <5"
  },
  "engines": {
    "node": ">=20"
  }
}
