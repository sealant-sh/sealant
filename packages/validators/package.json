{
  "name": "@sealant/validators",
  "version": "0.0.0",
  "private": true,
  "description": "Shared API and worker validation contracts",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./env": "./src/env.ts",
    "./ssh-public-key": "./src/ssh-public-key.ts",
    "./url-for-display": "./src/url-for-display.ts"
  },
  "scripts": {
    "lint": "OXLINT_TSGOLINT_PATH=../../node_modules/.bin/tsrs-lint oxlint --type-aware .",
    "test": "vitest run",
    "typecheck": "tsrs -p tsconfig.json --noEmit --checkers 1"
  },
  "dependencies": {
    "@sealant/api-contracts": "workspace:*",
    "@t3-oss/env-core": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@sealant/typescript": "workspace:*",
    "vitest": "catalog:"
  }
}
