{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "promise", "node", "unicorn"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    ".turbo/**",
    ".direnv/**"
  ],
  "rules": {
    "import/no-cycle": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "unicorn/prefer-node-protocol": "error",
    "no-underscore-dangle": [
      "error",
      {
        "allow": ["_splat", "_values"]
      }
    ]
  },
  "overrides": [
    {
      "files": ["**/*.ts"],
      "excludeFiles": [
        "packages/db/src/repositories/workspace-capture-drains.ts",
        "packages/db/src/repositories/capture-preservation.ts",
        "packages/db/src/schema/capture-preservation.ts",
        "packages/db/src/testing/**",
        "**/*.test.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/capture-preservation",
                  "**/capture-preservation.js",
                  "**/capture-preservation.ts"
                ],
                "message": "Boat custody persistence belongs to the canonical capture drain owner."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/api/src/routes/**/*.ts", "packages/workspaces/src/worker/**/*.ts"],
      "excludeFiles": ["**/*.test.ts", "**/*.fixture.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@sealant/db",
                "importNames": [
                  "NativePublicationRepo",
                  "NativePublicationRepoLive",
                  "nativePublications",
                  "nativePublicationConsumers"
                ],
                "message": "Native publication persistence belongs to BoatNativeCatalog."
              }
            ],
            "patterns": [
              {
                "group": [
                  "**/runtime/boat/api*",
                  "**/runtime/boat/config*",
                  "**/images/boat/builder*",
                  "**/images/boat/journal*",
                  "**/images/boat/recipe*",
                  "**/images/boat/runtime-bundle*",
                  "**/repositories/native-publications*",
                  "**/capture-preservation",
                  "**/capture-preservation.js",
                  "**/capture-preservation.ts",
                  "**/schema/native-publications*",
                  "@sealant/db/testing/*"
                ],
                "message": "Use the native catalog or read-only inspection service. Provider and journal internals stay in their owners."
              }
            ]
          }
        ]
      }
    }
  ]
}
