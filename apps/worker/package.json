{
  "name": "@sealant/worker",
  "version": "0.0.0",
  "private": true,
  "description": "Background worker for workspace image build jobs",
  "type": "module",
  "scripts": {
    "build": "node ../../tooling/scripts/bundle-app.mjs",
    "dev": "dotenv -e ../../.env -- tsx watch src/index.ts",
    "lint": "OXLINT_TSGOLINT_PATH=../../node_modules/.bin/tsrs-lint oxlint --type-aware .",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsrs -p tsconfig.json --noEmit --checkers 1"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "catalog:",
    "@openai/codex": "catalog:",
    "@sealant/api-contracts": "workspace:*",
    "@sealant/credentials": "workspace:*",
    "@sealant/db": "workspace:*",
    "@sealant/jobs": "workspace:*",
    "@sealant/source-integrations": "workspace:*",
    "@sealant/telemetry": "workspace:*",
    "@sealant/validators": "workspace:*",
    "@sealant/workspaces": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@sealant/typescript": "workspace:*",
    "dotenv-cli": "catalog:"
  }
}
