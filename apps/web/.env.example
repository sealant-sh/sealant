# URL of the Sealant control-plane API instance
# Used by the web app tRPC server when calling /v1/workspaces and /v1/registries
VITE_API_URL=http://localhost:4000

# Better Auth configuration for the TanStack Start web app
BETTER_AUTH_SECRET=replace-with-a-random-32-plus-character-secret
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# Browser error and trace reporting to Sentry. Off unless SENTRY_BROWSER_DSN is set: with no DSN the
# page never starts the Sentry SDK and makes no call to any Sentry host. Read at runtime by the web
# server and handed to the page; nothing is baked into the bundle.
# SENTRY_BROWSER_DSN=https://<public key>@<sentry host>/<project id>
# SENTRY_ENVIRONMENT=development
# SENTRY_TRACES_SAMPLE_RATE=1.0
