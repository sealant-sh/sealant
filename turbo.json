{
  "$schema": "https://turborepo.dev/schema.json",
  "cacheMaxAge": "14d",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tooling/scripts/bundle-app.mjs"],
      "outputs": ["dist/**", "build/**", ".next/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.oxlintrc.json"]
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": [],
      "env": ["SEALANT_*", "DATABASE_URL", "SEALANTD_BIN", "REQUIRE_SEALANTD"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    }
  }
}
